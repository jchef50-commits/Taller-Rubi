# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare line endings for source code
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.sh   text eol=lf
*.env  text eol=lf

# Windows-specific files
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Images and binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.svg  text eol=lf

# Prevent CRLF warnings for all files
